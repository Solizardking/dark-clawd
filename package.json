{
  "name": "@openclawdsolana/dark-clawd",
  "version": "1.0.0",
  "description": "Dark Clawd — autonomous Solana terminal intelligence (Bloomberg-style TUI + automation). Hub: cheshireterminal.ai/dark-clawd",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dark-clawd": "./dist/cli.js",
    "clawd": "./dist/cli.js",
    "clawd-tui": "./dist/cli.js",
    "dark-ralph": "./dist/cli.js",
    "ralph": "./dist/cli.js",
    "ralph-tui": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "copy:wasm": "sh -c 'mkdir -p dist && if [ -f node_modules/yoga-wasm-web/dist/yoga.wasm ]; then cp node_modules/yoga-wasm-web/dist/yoga.wasm dist/yoga.wasm; else cp ../node_modules/yoga-wasm-web/dist/yoga.wasm dist/yoga.wasm; fi'",
    "fix:shebang": "node tui/scripts/fix-shebang.mjs dist/cli.js || node scripts/fix-shebang.mjs dist/cli.js || true",
    "build": "bun build src/cli.tsx --outdir dist --target node && bun run copy:wasm",
    "build:lib": "bun build src/index.ts --outdir dist --target node && bun run copy:wasm",
    "start": "node dist/cli.js",
    "run": "bun run src/cli.tsx run",
    "setup": "bun run src/cli.tsx setup",
    "status": "bun run src/cli.tsx status",
    "wallet": "bun run src/cli.tsx wallet",
    "automaton": "bun run src/cli.tsx automaton",
    "automaton:status": "bun run src/cli.tsx automaton status",
    "automaton:constitution": "bun run src/cli.tsx automaton constitution",
    "automaton:paths": "bun run src/cli.tsx automaton paths",
    "automaton:help": "bun run src/cli.tsx automaton help",
    "automaton:install": "cd automaton && (pnpm install || npm install)",
    "automaton:build": "cd automaton && (pnpm run build || npm run build)",
    "automaton:test": "cd automaton && (pnpm test || npm test)",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "test": "bun test --pass-with-no-tests './src/**/*.test.ts' './src/**/*.test.tsx' './src/**/*.spec.ts' './src/**/*.spec.tsx'",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build && bun run build:lib"
  },
  "dependencies": {
    "@ellipsis-labs/rise": "^0.4.62",
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.87.6",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.1.0",
    "conf": "^12.0.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "eventsource-parser": "^1.1.1",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "ink": "^4.4.1",
    "ink-big-text": "^2.0.0",
    "ink-box": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-select-input": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "node-fetch": "^3.3.2",
    "openai": "^4.20.1",
    "ora": "^7.0.1",
    "react": "^18.2.0",
    "react-devtools-core": "^4.28.5",
    "terminal-link": "^3.0.0",
    "update-notifier": "^6.0.2",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.2.37",
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.5",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.2",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "bun-types": "latest"
  },
  "keywords": [
    "solana",
    "ai-agent",
    "tui",
    "terminal",
    "crypto",
    "trading",
    "autonomous",
    "helius",
    "birdeye",
    "grok",
    "perplexity",
    "bloomberg",
    "dark-clawd",
    "automaton",
    "sovereign-agent"
  ],
  "author": "OpenClawd",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solizardking/dark-clawd.git"
  },
  "homepage": "https://cheshireterminal.ai/dark-clawd",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bugs": {
    "url": "https://github.com/Solizardking/dark-clawd/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
